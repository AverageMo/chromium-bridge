{
  "manifest_version": 3,
  "name": "Chromium Bridge",
  "version": "1.0.0",
  "description": "Lets local scripts drive this Chrome (your logged-in tabs) through a loopback-only bridge server.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "debugger", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Chromium Bridge", "default_popup": "popup.html" }
}
